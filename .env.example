# Janjez Business Side — Environment Variables

# Supabase (Business Side's own project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Janjez Main API (server-to-server)
JANJEZ_MAIN_API_URL=https://janjez.social/api/business/v1
JANJEZ_MAIN_API_KEY=
JANJEZ_MAIN_API_SECRET=

# M-Pesa Daraja (Business Side's own account — pending approval)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=

# Site URL
NEXT_PUBLIC_SITE_URL=https://partners.janjez.social

# Monitoring
# SENTRY_DSN must start with https:// or http:// (e.g. https://key@sentry.io/123)
SENTRY_DSN=
BETTER_STACK_TOKEN=

# Activation & Billing
PARTNER_ACTIVATION_FEE=1499
WITHDRAWAL_FEE_PERCENT=5
WITHDRAWAL_MIN_AMOUNT=500

# Session
SESSION_COOKIE_NAME=jez_bs_session

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Partner Hub
NEXT_PUBLIC_PARTNER_HUB_DOMAIN=partners.janjez.social

# Security
HMAC_SECRET=

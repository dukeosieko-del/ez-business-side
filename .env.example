# Janjez Business Side — environment variables
# Use this file only as a template. Never commit real secrets.

# Business Side Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Janjez Main API — optional server-to-server adapter; never edit Main
JANJEZ_MAIN_API_URL=https://janjez.social/api/business/v1
JANJEZ_MAIN_API_KEY=
JANJEZ_MAIN_API_SECRET=

# Safaricom Daraja — sandbox by default; live calls stay disabled
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://business.janjez.social/api/partner/activate/callback
MPESA_CALLBACK_TOKEN=
MPESA_LIVE_PAYMENTS_ENABLED=false
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=

# Business Side canonical URL
NEXT_PUBLIC_SITE_URL=https://business.janjez.social

# Monitoring
SENTRY_DSN=
BETTER_STACK_TOKEN=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Separate SMTP relay credentials; API key is not an SMTP key.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# Activation & billing
PARTNER_ACTIVATION_FEE=1499
WITHDRAWAL_FEE_PERCENT=5
WITHDRAWAL_MIN_AMOUNT=500

# Session and idempotency
SESSION_COOKIE_NAME=jez_bs_session
IDEMPOTENCY_TTL_SECONDS=86400
NEXT_PUBLIC_PARTNER_HUB_DOMAIN=partners.janjez.social

# Security
HMAC_SECRET=
